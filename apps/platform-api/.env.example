# Local development. Copy to .env (not committed). See README「平台 API」.
# The platform API logs in as a member of yutis_platform (created by `pnpm --filter @yutis/platform-api db:seed`).
PLATFORM_DATABASE_URL=postgres://yutis_platform_local:yutis_platform_local@localhost:5432/yutis
# Table owner, for db:seed only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yutis
PORT=3001
TENANT_BASE_DOMAIN=localhost
# Send `X-Dev-Platform-User: ops@yutis.test` instead of the Identity-Aware Proxy header. Refused in production.
PLATFORM_DEV_AUTH=true
# Fake Cloud KMS, Identity Platform and email that only log. Refused in production.
PLATFORM_FAKE_INTEGRATIONS=true
