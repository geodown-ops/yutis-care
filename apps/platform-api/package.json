{
  "name": "@yutis/platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "Yutis Care 平台 API（NestJS + Fastify）：平台管理後台用，管理租戶、方案與用量，看不到任何健康資料。",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "pnpm --filter @yutis/platform-api... build && node --env-file-if-exists=.env dist/main.js",
    "openapi": "node dist/openapi-cli.js",
    "db:seed": "tsx --conditions=@yutis/source --env-file-if-exists=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@yutis/db": "workspace:*",
    "@yutis/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
