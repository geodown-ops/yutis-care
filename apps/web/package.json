{
  "name": "@yutis/web",
  "version": "0.1.0",
  "private": true,
  "description": "Yutis Care 租戶後台（{租戶}.care.yutis.com.tw/）：職護、職醫、職安衛、人資、主管與租戶管理員使用。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "routes": "tsr generate",
    "build": "tsr generate && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mantine/charts": "^9.6.3",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@yutis/api-client": "workspace:*",
    "@yutis/domain": "workspace:*",
    "@yutis/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
