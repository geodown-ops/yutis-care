# Local development. Copy to .env (not committed). See README「租戶 API」.
# The API logs in as a member of yutis_app (created by `pnpm --filter @yutis/api db:seed`), never as the table owner.
APP_DATABASE_URL=postgres://yutis_api_local:yutis_api_local@localhost:5432/yutis
# The worker (exports, nightly retention scan) logs in as a member of yutis_worker.
WORKER_DATABASE_URL=postgres://yutis_worker_local:yutis_worker_local@localhost:5432/yutis
# Table owner, for db:seed and jobs:install only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yutis
PORT=3000
# Tenants at {slug}.localhost:3000, e.g. http://demo.localhost:3000/api/tenant
TENANT_BASE_DOMAIN=localhost
COOKIE_SECURE=false
# Sign in with an email or phone number as the token (POST /api/auth/sign-in). Refused in production.
AUTH_DEV_SIGN_IN=true
# Local master key for encrypting medical text and fingerprinting national IDs (32 bytes, base64). Refused in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_CRYPTO_LOCAL_KEY=
# Email (staff invitations, sign-off and confirmation links, fill-in reminders). `log` only logs; `resend` sends via Resend.
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM=Yutis Care <noreply@care.yutis.com.tw>
# The worker reads this file too; give it its own port for its health check (the API has PORT).
# WORKER_PORT=3002
