{
  "name": "@yutis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Yutis Care 租戶 API（NestJS + Fastify）：租戶後台與員工端共用。",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "pnpm --filter @yutis/api... build && node --env-file-if-exists=.env dist/main.js",
    "openapi": "node dist/openapi-cli.js",
    "db:seed": "tsx --conditions=@yutis/source --env-file-if-exists=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@yutis/db": "workspace:*",
    "@yutis/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
