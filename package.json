{
  "name": "yutis-care",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prototype": "node prototype/scripts/serve.js",
    "dev:web": "pnpm --filter @yutis/web dev",
    "dev:portal": "pnpm --filter @yutis/portal dev",
    "dev:platform": "pnpm --filter @yutis/platform-web dev",
    "dev:site": "pnpm --filter @yutis/site dev"
  }
}
